services:
  caddy:
    image: docker.io/library/caddy:2-alpine
    container_name: {{ caddy_container_name }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - {{ network_name }}

networks:
  {{ network_name }}:
    external: true

volumes:
  caddy_data:
  caddy_config:
